# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: Your OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# Optional: Override default output file paths
# NOTES_FILE=~/tutorial_notes.md
# TRANSCRIPT_FILE=~/tutorial_transcript.md

# Optional: Change chunk duration (seconds). Default: 60
# CHUNK_SECS=60

# Optional: Change GPT model. Default: gpt-4o-mini (cheap + fast)
# Upgrade to gpt-4o for higher quality notes
# NOTES_MODEL=gpt-4o-mini
