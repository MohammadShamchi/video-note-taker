<?xml version="1.0" encoding="UTF-8"?>
<!--
  Personal-use entitlements: App Sandbox is DISABLED so the app can run the
  ffmpeg binary via Process() and capture avfoundation audio. This is fine for
  a local tool. For distribution you'd need a sandbox-compatible capture path.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
